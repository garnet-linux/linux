# Xiaomi Redmi Note 13 Pro 5G (garnet) bring-up fragment.
# Usage: make ARCH=arm64 defconfig garnet.config   (or: make garnet.config on an existing .config)

CONFIG_ARCH_QCOM=y
CONFIG_SMP=y

# Boot via Mu-Silicium UEFI: kernel is an EFI app, DTB + initrd loaded by the stub
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_EARLYCON=y
CONFIG_EFI_ARMSTUB_DTB_LOADER=y
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="dtb=sm7435-xiaomi-garnet-usb.dtb initrd=initramfs.img earlycon=efifb console=tty0 ignore_loglevel loglevel=8 clk_ignore_unused pd_ignore_unused panic=10 rdinit=/init"
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Screen: UEFI GOP framebuffer via simpledrm
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Crash logs from the ramoops region
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# USB gadget (stage 2a): dwc3 + Qualcomm glue, ConfigFS gadgets
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_CONFIGFS_FS=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVPTS_FS=y
CONFIG_NET=y
CONFIG_INET=y
