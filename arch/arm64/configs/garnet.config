# Xiaomi Redmi Note 13 Pro 5G (garnet) bring-up fragment.
# Usage: make ARCH=arm64 defconfig garnet.config   (or: make garnet.config on an existing .config)
#
# Untested: built from your original fragment plus options taken from your
# working config. Check that `make garnet.config` doesn't drop any symbols.

CONFIG_ARCH_QCOM=y
CONFIG_SMP=y

# Boot via Mu-Silicium UEFI: kernel is an EFI app, DTB + initrd loaded by the stub
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_EARLYCON=y
CONFIG_EFI_ARMSTUB_DTB_LOADER=y
CONFIG_CMDLINE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Screen: UEFI GOP framebuffer via simpledrm (matches your working config:
# card0 = simpledrm, card1 = msm GPU)
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SYSFB_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
# CONFIG_FB_SIMPLE is not set

# Crash logs from the ramoops region
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# USB gadget (stage 2a): dwc3 + Qualcomm glue, ConfigFS gadgets
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_CONFIGFS_FS=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVPTS_FS=y
CONFIG_NET=y
CONFIG_INET=y

# Core SoC plumbing (clocks, power domains, IRQs, interconnect)
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_7435=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM7435=y
CONFIG_PM_OPP=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y

# UFS (stage 2b): SM7435 GCC clocks, UFS host controller and QMP UFS PHY
CONFIG_GENERIC_PHY=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y

# Root filesystem on the embedded UFS device (GPT partitioned)
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y

# Touchscreen: TLMM pinctrl + QUP/GENI SPI + FocalTech FT3683G
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM7435=y
CONFIG_GPIOLIB=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_QCOM_GENI=y
# The QUP serial engines use GPI DMA for the transfers
CONFIG_QCOM_GPI_DMA=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FOCALTECH_3683G=y
# Other garnet panels use a Goodix GT9916S instead
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_CORE=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=y

# USB HS PHY (stage 2c)
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# WPSS remoteproc (WiFi firmware host) and what it needs
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_QMI_HELPERS=y

# QMI handle used by q6v5/PAS needs an AF_QIPCRTR socket at probe time
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# WiFi: the WPSS firmware exposes the ath10k QMI WLAN service
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH10K_DEBUG=y

# GPU: msm with MDSS enabled (as in your working config). Keep the mdss/dpu/dsi
# nodes disabled in the device tree so simpledrm keeps scanout.
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_IO_PGTABLE_LPAE=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_UBWC_CONFIG=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_ADRENO=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_SM_GPUCC_7435=y
# CONFIG_DRM_MSM_GPU_STATE is not set

# Firmware: the initramfs has no modules, so ship GPU firmware in the initramfs
# under /lib/firmware/qcom/ or embed it (file names: check dmesg for the
# exact ones requested):
CONFIG_FW_LOADER=y
# CONFIG_EXTRA_FIRMWARE="qcom/..."
# CONFIG_EXTRA_FIRMWARE_DIR="/path/to/firmware"

# Native display: SM7435 DISPCC + NT37706 panel, all built in.
CONFIG_SM_DISPCC_7435=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_NOVATEK_NT37706=y
# MDSS: qcom_ubwc_config_get_data() needs SMEM
CONFIG_HWSPINLOCK=y
