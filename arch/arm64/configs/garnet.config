# Xiaomi Redmi Note 13 Pro 5G (garnet) bring-up fragment.
# Usage: make ARCH=arm64 defconfig garnet.config   (or: make garnet.config on an existing .config)

CONFIG_ARCH_QCOM=y
CONFIG_SMP=y

# Boot via Mu-Silicium UEFI: kernel is an EFI app, DTB + initrd loaded by the stub
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_EARLYCON=y
CONFIG_EFI_ARMSTUB_DTB_LOADER=y
CONFIG_CMDLINE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Screen: UEFI GOP framebuffer via the fbdev "simplefb" driver.
# The panel keeps scanning the framebuffer that UEFI set up, so the console
# must render into that buffer directly.  Do NOT use CONFIG_DRM_SIMPLEDRM:
# its fbdev emulation hands out a shmem buffer and modesets the (virtual)
# CRTC to it, which the display hardware never scans out - the console
# output (and the Tux logo) would be invisible.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_DRM=y

# Native display: SM7435 DISPCC + MSM DPU/DSI + NT37706 panel, all built in.
# The panel Kconfig symbol "depends on BACKLIGHT_CLASS_DEVICE" (and needs
# DRM_MIPI_DSI), and arm64 defconfig has BACKLIGHT_CLASS_DEVICE=m / DRM_MSM=m,
# which silently capped DRM_PANEL_NOVATEK_NT37706 at =m.  Everything it
# depends on has to be =y as well.
CONFIG_SM_DISPCC_7435=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# DRM_MSM only goes built-in if QCOM_LLCC / QCOM_OCMEM (both optional
# "|| =n" dependencies) are not modules, defconfig has them as =m.
CONFIG_QCOM_LLCC=y
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_NOVATEK_NT37706=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y

# Crash logs from the ramoops region
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# USB gadget (stage 2a): dwc3 + Qualcomm glue, ConfigFS gadgets
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_CONFIGFS_FS=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVPTS_FS=y
CONFIG_NET=y
CONFIG_INET=y

# UFS (stage 2b): SM7435 GCC clocks, UFS host controller and QMP UFS PHY
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_7435=y
CONFIG_QCOM_GDSC=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y

# Root filesystem on the embedded UFS device (GPT partitioned)
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y


# Touchscreen: TLMM pinctrl + QUP/GENI SPI + FocalTech FT3683G
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM7435=y
CONFIG_GPIOLIB=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_QCOM_GENI=y
# The QUP serial engines use GPI DMA for the transfers: the DMA controller
# has to be built in, otherwise the SPI controller defers its probe forever.
CONFIG_QCOM_GPI_DMA=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FOCALTECH_FT3683G=y
# Other garnet panels use a Goodix GT9916S instead (switch the compatible
# in the device tree to "goodix,gt9916" for those).
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_CORE=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=y

# USB HS PHY (stage 2c): without it dwc3-qcom stays in deferred probe.
# initramfs has no modules, so everything below must be built in.
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# WPSS remoteproc (WiFi firmware host) and what it needs
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_RPMHPD=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_REGULATOR_QCOM_RPMH=y

# QMI handle used by q6v5/PAS needs an AF_QIPCRTR socket at probe time
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# WiFi: the WPSS firmware exposes the ath10k QMI WLAN service
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH10K_DEBUG=y

# MDSS: qcom_ubwc_config_get_data() needs SMEM (HWSPINLOCK_QCOM and
# QCOM_SMEM are already set above); without it MDSS defers forever.
CONFIG_HWSPINLOCK=y

# Load .zst-compressed firmware (linux-firmware ships ath10k files that way)
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
